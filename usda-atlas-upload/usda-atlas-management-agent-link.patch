+  /**
+   * The management agent, rendered as a link to every property that firm
+   * manages. USDA spells the same firm several ways, so the link carries the
+   * folded key the ?mgmt= filter expects rather than the raw string, and the
+   * count is taken from the same fold so the number and the destination agree.
+   * A firm with a single property gets no link, because the filtered table
+   * would only show the property already on screen.
+   */
+  function managerLink(d) {
+    const label = titleCase(d.management);
+    if (!label) return "-";
+    const key = normManager(d.management);
+    if (!key) return label;
+    const n = index.filter((r) => normManager(r.management) === key).length;
+    if (n <= 1) return label;
+    return `<a href="index.html?mgmt=${encodeURIComponent(key)}"
+      title="See every USDA property this firm manages">${label}</a>
+      <span class="muted">(${n.toLocaleString()} properties)</span>`;
+  }
+
